# Copy this file to .env.local (never committed) and fill in the values.
# On Vercel, add the same names under Settings → Environment Variables.

# Main AI: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Backup AI: free key from https://console.groq.com/keys
GROQ_API_KEY=

# Rate limiting: Vercel → Storage → Upstash Redis fills these in on Vercel.
# For local testing, copy them from Vercel or the Upstash dashboard.
# (Optional locally: without them, `npm run dev` skips rate limiting.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
